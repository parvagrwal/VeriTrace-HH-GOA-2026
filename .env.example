# VeriTrace Environment Configuration
# Copy this file to .env and replace with your actual keys

# SerpApi API Key (Sign up for free 100 searches/mo at https://serpapi.com)
SERPAPI_KEY=your_serpapi_api_key_here

# Polygon Amoy Testnet RPC URL (Reliable public RPC: https://polygon-amoy.drpc.org)
AMOY_RPC_URL=https://polygon-amoy.drpc.org

# Throwaway Testnet Wallet Private Key (Do NOT use a mainnet key or wallet with real funds)
# Get free testnet POL from https://faucet.polygon.technology
PRIVATE_KEY=your_testnet_private_key_hex_here

# Deployed VerificationRegistry Contract Address on Polygon Amoy
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
